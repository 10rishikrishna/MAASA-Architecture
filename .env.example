# MAASA - Environment Variables Template
# Copy this file to .env and fill in your values

# --- JWT Auth ---
JWT_SECRET=replace-with-a-long-random-secret-string

# --- Database ---
# Default: SQLite file (good for local dev)
DATABASE_URL=sqlite:///./maasa.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/maasa_db

# --- LLM API Keys (Optional) ---
# Without these, the agent uses rich mock data for demos
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
