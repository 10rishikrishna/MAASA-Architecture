# Mosaic Studio - Environment Variables Template
# Copy this file to .env and fill in your values

# --- JWT Auth ---
JWT_SECRET=replace-with-a-long-random-secret-string

# --- Database ---
# Default: SQLite file (good for local dev)
DATABASE_URL=sqlite:///./mosaic_studio.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/mosaic_studio_db

# --- Redis (Cache + Message Queue) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM API Keys (Optional) ---
# Without these, the agent uses rich mock data for demos
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability ---
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9090
ELASTICSEARCH_URL=http://localhost:9200

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Circuit Breaker ---
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30
